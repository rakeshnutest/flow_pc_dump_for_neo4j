  "description": "Independent CVM ping dashboard from sysstats ping_gateway / ping_all / ping_remotes (latency ms + unreachable drops). Not tied to SAR role/iface filters.",
  "panels": [
    {
      "type": "timeseries",
      "title": "Ping latency (ms)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-sar"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-sar"
          },
          "query": "from(bucket: \"sar\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ping\")\n  |> filter(fn: (r) => r.host =~ /${ping_host:regex}/)\n  |> filter(fn: (r) => r.ping_kind =~ /${ping_kind:regex}/)\n  |> filter(fn: (r) => r.target =~ /${ping_target:regex}/)\n  |> filter(fn: (r) => r._field == \"latency_ms\")\n  |> filter(fn: (r) => r._value >= 0.0)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ]
    },
